    console.log(
        `🌎 Selecting ${wanted}...`
    );

    const aliases =
        LANGUAGE_ALIASES[wanted] ||
        [wanted];

    const normalizedAliases =
        aliases.map(
            normalizeText
        );

    for (
        let attempt = 1;
        attempt <= LANGUAGE_CHECKS;
        attempt++
    ) {

        const clicked =
            await page.evaluate(
                aliases => {

                    function visible(el) {

                        if (!el)
                            return false;

                        const rect =
                            el.getBoundingClientRect();

                        const style =
                            getComputedStyle(el);

                        return (
                            rect.width > 0 &&
                            rect.height > 0 &&
                            style.display !== "none" &&
                            style.visibility !== "hidden"
                        );
                    }

                    function normalize(text) {

                        return String(text || "")
                            .replace(/\u00a0/g, " ")
                            .replace(/\s+/g, " ")
                            .trim()
                            .toLowerCase();
                    }

                    const candidates = [
                        ...document.querySelectorAll("*")
                    ]
                    .filter(visible)
                    .filter(el => {

                        return aliases.includes(
                            normalize(
                                el.innerText ||
                                el.textContent ||
                                ""
                            )
                        );
                    });

                    candidates.sort(
                        (a, b) => {

                            const ar =
                                a.getBoundingClientRect();

