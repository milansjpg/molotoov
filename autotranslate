    try {

        const connection =
            await connect();

        browser =
            connection.browser;

        const page =
            connection.page;

        // ----------------------------------------------------
        // FIND VIDEOS + SHORTS + LIVE
        // ----------------------------------------------------

        const videos =
            await findVideos(
                page
            );

        if (!videos.length) {

            console.log(
                "❌ No PUBLIC videos found."
            );

            return;
        }

        console.log("");
        console.log(
            "================================================"
        );

        console.log(
            `🎉 PROCESSING ${videos.length} UNIQUE PUBLIC VIDEOS`
        );

        console.log(
            "================================================"
        );

        // ----------------------------------------------------
        // PROCESS
        // ----------------------------------------------------

        for (
            let i = 0;
            i < videos.length;
            i++
        ) {

            try {

                await processVideo(
                    page,
                    videos[i],
                    i + 1,
                    videos.length
                );

            } catch (err) {

                console.log("");
                console.log(
                    `❌ VIDEO ${i + 1} ERROR`
                );

                console.log(
                    err.message
                );

                console.log(
                    "⏭️ Moving to next video."
                );
            }

            await sleep(3000);
        }

        console.log("");
        console.log(
            "================================================"
        );

        console.log(
            "🎉 ALL PUBLIC VIDEOS COMPLETE"
        );

        console.log(
            "================================================"
        );

    } catch (err) {

        console.log("");
        console.log(
            "❌ FATAL ERROR:"
        );

        console.log(err);

    } finally {

        console.log("");
        console.log(
            "Chrome left open."
        );
    }

})();
