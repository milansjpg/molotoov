                    );

                    if (!candidates.length)
                        return false;

                    const target =
                        candidates[0];

                    try {

                        target.scrollIntoView({
                            block: "center"
                        });

                    } catch {}

                    try {

                        target.click();

                        return true;

                    } catch {}

                    return false;
                },
                normalizedAliases
            );

        if (clicked) {

            console.log(
                `✅ ${wanted} selected.`
            );

            await sleep(1500);

            return true;
