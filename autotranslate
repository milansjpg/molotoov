// ============================================================
// HARD NAVIGATION
//
// YouTube Studio sometimes refuses page.goto() with
// ERR_ABORTED because of its SPA/beforeunload behavior.
//
// We therefore try:
// 1. normal goto
// 2. browser address/navigation through location
// 3. keyboard address-bar navigation
// ============================================================

async function navigateTo(page, url, expectedVideoId = null) {

    console.log("");
    console.log("Navigating to:");
    console.log(url);

    const expectedPath =
        new URL(url).pathname;

    function correctUrl(current) {

        if (!current)
            return false;

        if (!current.includes(expectedPath))
            return false;

        if (
            expectedVideoId &&
            !current.includes(
                `/video/${expectedVideoId}/`
            )
        ) {
            return false;
        }

        return true;
    }

    // --------------------------------------------------------
    // Already there
    // --------------------------------------------------------

    if (correctUrl(page.url())) {

        console.log("✅ Already on requested page.");

        await sleep(PAGE_LOAD_DELAY);

        return true;
    }

    // --------------------------------------------------------
    // Attempt 1: Puppeteer goto
    // --------------------------------------------------------

    try {

        await page.goto(url, {
            waitUntil: "domcontentloaded",
            timeout: NAVIGATION_TIMEOUT
        });

    } catch (err) {

        console.log(
            `⚠️ page.goto: ${err.message}`
        );
    }

    await sleep(2000);

    if (correctUrl(page.url())) {

        console.log("✅ Navigation successful.");

        await sleep(PAGE_LOAD_DELAY);

        return true;
    }

    // --------------------------------------------------------
    // Attempt 2: location.href
    // --------------------------------------------------------

    console.log(
        "↪️ Trying browser-side navigation..."
    );

    try {

        await page.evaluate(target => {
            window.location.href = target;
        }, url);

    } catch (err) {

        console.log(
            `⚠️ Browser-side navigation: ${err.message}`
        );
    }

    for (
        let i = 1;
        i <= NAVIGATION_CHECKS;
        i++
    ) {

        if (correctUrl(page.url())) {

            console.log(
                "✅ Browser-side navigation successful."
            );

            await sleep(PAGE_LOAD_DELAY);

            return true;
        }

        if (
            i === 1 ||
            i % 5 === 0
        ) {

            console.log(
                `⏳ Waiting for navigation... ${i}/${NAVIGATION_CHECKS}`
            );

            console.log(
                `   Current: ${shortUrl(page.url())}`
            );
        }

        await sleep(NAVIGATION_DELAY);
    }

    // --------------------------------------------------------
    // Attempt 3: Ctrl+L / Enter
    // --------------------------------------------------------

    console.log(
        "↪️ Using Chrome address-bar navigation..."
    );

    try {

        await page.bringToFront();

        await page.keyboard.down("CTRL");
        await page.keyboard.press("L");
        await page.keyboard.up("CTRL");

        await sleep(300);

        await page.keyboard.type(
            url,
            { delay: 1 }
        );

        await page.keyboard.press("ENTER");

    } catch (err) {

        console.log(
            `⚠️ Address-bar navigation failed: ${err.message}`
        );
    }

    for (
        let i = 1;
        i <= NAVIGATION_CHECKS;
        i++
    ) {

        if (correctUrl(page.url())) {

            console.log(
                "✅ Address-bar navigation successful."
            );

            await sleep(PAGE_LOAD_DELAY);

            return true;
        }

        if (
            i === 1 ||
            i % 5 === 0
        ) {

            console.log(
                `⏳ Waiting for navigation... ${i}/${NAVIGATION_CHECKS}`
            );
        }

        await sleep(NAVIGATION_DELAY);
    }

    console.log(
        "❌ Could not navigate to requested page."
    );

    console.log(
        "Current URL:",
        page.url()
    );

    return false;
}

// ============================================================
// VISIBILITY
// ============================================================

async function scrapeVideoRows(page) {

    return await page.evaluate(() => {

        function visible(el) {

            if (!el)
                return false;

            const rect =
                el.getBoundingClientRect();

            const style =
                getComputedStyle(el);

            return (
                rect.width > 0 &&
                rect.height > 0 &&
                style.display !== "none" &&
                style.visibility !== "hidden"
            );
        }

        function clean(text) {

            return String(text || "")
                .replace(/\u00a0/g, " ")
                .replace(/\s+/g, " ")
                .trim();
        }

        // Search normal DOM + shadow DOM.
        function allElements(selector) {

            const output = [];

            function walk(root) {

                try {

                    root
                        .querySelectorAll(selector)
                        .forEach(el =>
                            output.push(el)
                        );

                    root
                        .querySelectorAll("*")
                        .forEach(el => {

                            if (el.shadowRoot) {
                                walk(el.shadowRoot);
                            }

                        });

                } catch {}
            }

            walk(document);

            return output;
        }

        const rows =
            allElements("ytcp-video-row");

        const results = [];
        const seen = new Set();

        for (const row of rows) {

            if (!visible(row))
                continue;

            const rowText =
                clean(
                    row.innerText ||
                    row.textContent ||
                    ""
                );

            if (!rowText)
                continue;

            const lower =
                rowText.toLowerCase();

            // ------------------------------------------------
            // Visibility
            // ------------------------------------------------

            const publicVideo =
                /\bpublic\b/i.test(rowText);

            if (!publicVideo)
                continue;

            if (
                /\bprivate\b/i.test(rowText) ||
                /\bunlisted\b/i.test(rowText) ||
                /\bscheduled\b/i.test(rowText) ||
                /\bdraft\b/i.test(rowText) ||
                /members[\s-]*only/i.test(rowText)
            ) {
                continue;
            }

            // ------------------------------------------------
            // Video ID
            // ------------------------------------------------

            const links = [
                ...row.querySelectorAll(
                    'a[href*="/video/"]'
                )
            ];

            let videoId = null;

            for (const link of links) {

                const href =
                    link.getAttribute("href") || "";

                const match =
                    href.match(
                        /\/video\/([^/?#]+)/
                    );

                if (match) {

                    videoId =
                        match[1];

                    break;
                }
            }

            if (!videoId)
                continue;

            if (seen.has(videoId))
                continue;

            // ------------------------------------------------
            // Title
            // ------------------------------------------------

            let title = "";

            const titleSelectors = [
                "#video-title",
                "a#video-title",
                ".video-title",
                "[id='video-title']"
            ];

            for (const selector of titleSelectors) {

                const el =
                    row.querySelector(selector);

                if (!el)
                    continue;

                const candidate =
                    clean(
                        el.innerText ||
                        el.textContent ||
                        ""
                    );

                if (
                    candidate &&
                    !/^\d+:\d+(:\d+)?$/.test(candidate)
                ) {

                    title =
                        candidate;

                    break;
                }
            }

            // aria fallback
            if (!title) {

                const link =
                    links[0];

                if (link) {

                    title =
                        clean(
                            link.getAttribute(
                                "aria-label"
                            ) ||
                            link.getAttribute(
                                "title"
                            ) ||
                            ""
                        );
                }
            }

            // Generic fallback
            if (!title) {

                const pieces =
                    rowText
                        .split(/\n+/)
                        .map(clean)
                        .filter(Boolean);

                for (const piece of pieces) {

                    const p =
                        piece.toLowerCase();

                    if (
                        p === "public" ||
                        p === "published" ||
                        p === "private" ||
                        p === "unlisted" ||
                        p === "scheduled" ||
                        p === "draft"
                    ) {
                        continue;
                    }

                    if (
                        /^\d+:\d+(:\d+)?$/.test(piece)
                    ) {
                        continue;
                    }

                    if (piece.length > 2) {

                        title =
                            piece;

                        break;
                    }
                }
            }

            seen.add(videoId);

            results.push({
                id: videoId,
                title: title || "Untitled video"
            });
        }

        return results;
    });
}

// ============================================================
// GET PAGE SIGNATURE
// ============================================================

async function getVideoPageSignature(page) {

    return await page.evaluate(() => {

        const rows = [
            ...document.querySelectorAll(
                "ytcp-video-row"
            )
        ];

        return rows
            .map(row => {

                const link =
                    row.querySelector(
                        'a[href*="/video/"]'
                    );

                return (
                    link?.getAttribute("href") ||
                    ""
                );
            })
            .filter(Boolean)
            .join("|");
    });
}

// ============================================================
// NEXT BUTTON
// ============================================================

async function clickNextVideosPage(page) {

    return await page.evaluate(() => {

        function visible(el) {

            if (!el)
                return false;

            const rect =
                el.getBoundingClientRect();

            const style =
                getComputedStyle(el);

            return (
                rect.width > 0 &&
                rect.height > 0 &&
                style.display !== "none" &&
                style.visibility !== "hidden"
            );
        }

        function normalize(text) {

            return String(text || "")
                .replace(/\s+/g, " ")
                .trim()
                .toLowerCase();
        }

        const elements = [
            ...document.querySelectorAll(
                "button,[role='button'],tp-yt-paper-icon-button"
            )
        ]
        .filter(visible);

        const exactLabels = [
            "next",
            "next page",
            "next page of videos",
            "go to next page"
        ];

        // First explicit aria/title.
        for (const el of elements) {

            const aria =
                normalize(
                    el.getAttribute("aria-label")
                );

            const title =
                normalize(
                    el.getAttribute("title")
                );

            const disabled =
                el.disabled ||
                el.getAttribute(
                    "aria-disabled"
                ) === "true";

            if (disabled)
                continue;

            if (
                exactLabels.includes(aria) ||
                exactLabels.includes(title)
            ) {

                el.scrollIntoView({
                    block: "center"
                });

                el.click();

                return true;
            }
        }

        // Text Next.
        for (const el of elements) {

            if (
                normalize(
                    el.innerText ||
                    el.textContent
                ) !== "next"
            ) {
                continue;
            }

            const disabled =
                el.disabled ||
                el.getAttribute(
                    "aria-disabled"
                ) === "true";

            if (disabled)
                continue;

            el.scrollIntoView({
                block: "center"
            });

            el.click();

            return true;
        }

        return false;
    });
}

// ============================================================
// WAIT FOR PAGE CHANGE
// ============================================================

async function waitForVideoPageChange(
    page,
    previousSignature,
    previousIds
) {

    for (
        let i = 1;
        i <= PAGINATION_CHECKS;
        i++
    ) {

        await sleep(PAGINATION_DELAY);

        const signature =
            await getVideoPageSignature(
                page
            );

        const rows =
            await scrapeVideoRows(page);

        const newRows =
            rows.filter(
                x => !previousIds.has(x.id)
            );

        if (
            signature &&
            signature !== previousSignature &&
            newRows.length
        ) {

            return true;
        }
    }

    return false;
}

// ============================================================
// FIND VIDEOS ON ONE TAB
// ============================================================

async function scanVideoTab(
    page,
    tabName,
    url,
    globalVideos
) {

    console.log("");
    console.log(
        "================================================"
    );

    console.log(
        `📺 SCANNING ${tabName.toUpperCase()}`
    );

    console.log(
        "================================================"
    );

    if (
        !await navigateTo(
            page,
            url
        )
    ) {

        console.log(
            `❌ Could not open ${tabName}.`
        );

        return;
    }

    let pageNumber = 1;

    while (true) {

        console.log("");
        console.log(
            `📄 ${tabName} PAGE ${pageNumber}`
        );

        // Scroll so Studio renders rows.
        await page.evaluate(() => {

            window.scrollTo(
                0,
                document.documentElement.scrollHeight
            );

        });

        await sleep(1500);

        const found =
            await scrapeVideoRows(page);

        let added = 0;

        for (const video of found) {

            if (!globalVideos.has(video.id)) {

                globalVideos.set(
                    video.id,
                    {
                        ...video,
                        type: tabName,
                        url:
                            translationsUrl(
                                video.id
                            )
                    }
                );

                added++;
            }
        }

        console.log(
            `📜 ${tabName}: ${found.length} public rows`
        );

        console.log(
            `➕ Added ${added} new videos`
        );

        console.log(
            `📊 Total unique videos: ${globalVideos.size}`
        );

        // ----------------------------------------------------
        // Pagination
        // ----------------------------------------------------

        const previousIds =
            new Set(
                found.map(x => x.id)
            );

        const previousSignature =
            await getVideoPageSignature(
                page
            );

        const clicked =
            await clickNextVideosPage(
                page
            );

        if (!clicked) {

            console.log(
                `✅ No more ${tabName} pages.`
            );

            break;
        }

        console.log(
            `➡️ ${tabName}: Next clicked.`
        );

        const changed =
            await waitForVideoPageChange(
                page,
                previousSignature,
                previousIds
            );

        if (!changed) {

            console.log(
                "⚠️ Next clicked but page did not change."
            );

            // One last scrape.
            await sleep(3000);

            const retry =
                await scrapeVideoRows(page);

            let retryAdded = 0;

            for (const video of retry) {

                if (!globalVideos.has(video.id)) {

                    globalVideos.set(
                        video.id,
                        {
                            ...video,
                            type: tabName,
                            url:
                                translationsUrl(
                                    video.id
                                )
                        }
                    );

                    retryAdded++;
                }
            }

            if (!retryAdded) {

                console.log(
                    "🛑 Stopping this tab."
                );

                break;
            }
        }

        pageNumber++;

        if (pageNumber > 1000) {

            console.log(
                "⚠️ Pagination safety limit reached."
            );

            break;
        }
    }
}

