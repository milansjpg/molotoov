async function clickExactText(
    page,
    wantedTexts,
    options = {}
) {

    const timeout =
        options.timeout || 45000;

    const interval =
        options.interval || 1000;

    const texts =
        wantedTexts.map(
            normalizeText
        );

    const started =
        Date.now();

    while (
        Date.now() - started <
        timeout
    ) {

        const clicked =
            await page.evaluate(
                texts => {

                    function visible(el) {

                        if (!el)
                            return false;

                        const rect =
                            el.getBoundingClientRect();

                        const style =
                            getComputedStyle(el);

                        return (
                            rect.width > 0 &&
                            rect.height > 0 &&
                            style.display !== "none" &&
                            style.visibility !== "hidden"
                        );
                    }

                    function normalize(text) {

                        return String(text || "")
                            .replace(/\u00a0/g, " ")
                            .replace(/\s+/g, " ")
                            .trim()
                            .toLowerCase();
                    }

                    const elements = [
                        ...document.querySelectorAll(
                            "*"
                        )
                    ]
                    .filter(visible);

                    const candidates =
                        elements.filter(el => {

                            return texts.includes(
                                normalize(
                                    el.innerText ||
                                    el.textContent ||
                                    ""
                                )
                            );
                        });

                    // Prefer buttons.
                    candidates.sort(
                        (a, b) => {

                            const aButton =
                                a.tagName === "BUTTON" ||
                                a.getAttribute("role") === "button";

                            const bButton =
                                b.tagName === "BUTTON" ||
                                b.getAttribute("role") === "button";

                            if (
                                aButton &&
                                !bButton
                            )
                                return -1;

                            if (
                                !aButton &&
                                bButton
                            )
                                return 1;

                            const ar =
                                a.getBoundingClientRect();

                            const br =
                                b.getBoundingClientRect();

                            return (
                                ar.width *
                                ar.height -
                                br.width *
                                br.height
                            );
                        }
                    );

                    if (!candidates.length)
                        return false;

                    const target =
                        candidates[0];

                    try {

                        target.scrollIntoView({
                            block: "center",
                            inline: "center"
                        });

                    } catch {}

                    try {

                        target.click();

                        return true;

                    } catch {}

                    return false;
                },
                texts
            );

        if (clicked)
            return true;

        await sleep(interval);
    }

    return false;
}

// ============================================================
// CHECK ENGLISH ROW
//
// THIS IS THE IMPORTANT PART.
//
// We explicitly inspect the English row.
//
// We DO NOT:
// - accept a generic subtitle editor
// - accept a generic Publish button
// - accept "edit subtitles" for another language
//
// We need an actual English row.
// ============================================================

async function inspectEnglishRow(page) {

    return await page.evaluate(() => {

        function visible(el) {

            if (!el)
                return false;

            const rect =
                el.getBoundingClientRect();

            const style =
                getComputedStyle(el);

            return (
                rect.width > 0 &&
                rect.height > 0 &&
                style.display !== "none" &&
                style.visibility !== "hidden"
            );
        }

        function clean(text) {

            return String(text || "")
                .replace(/\u00a0/g, " ")
                .replace(/\s+/g, " ")
                .trim();
        }

        function norm(text) {
            return clean(text).toLowerCase();
        }

        const elements = [
            ...document.querySelectorAll("*")
        ]
        .filter(visible);

        const englishLabels =
            elements.filter(el => {

                const text =
                    norm(
                        el.innerText ||
                        el.textContent ||
                        ""
                    );

                return (
                    text === "english" ||
                    text === "english (united states)" ||
                    text === "english (us)" ||
                    text === "english - united states"
                );
            });

        // ----------------------------------------------------
        // Find the actual row around English.
        // ----------------------------------------------------

        for (const english of englishLabels) {

            let row =
                english;

            for (
                let level = 0;
                level < 15 && row;
                level++
            ) {

                const rowText =
                    clean(
                        row.innerText ||
                        row.textContent ||
                        ""
                    );

                const lower =
                    norm(rowText);

                // A useful row should contain English plus
                // some subtitle-related state/action.
                if (
                    lower.includes("english") &&
                    (
                        lower.includes("automatic") ||
                        lower.includes("published") ||
                        lower.includes("draft") ||
                        lower.includes("edit subtitles") ||
                        lower.includes("edit") ||
                        lower.includes("add")
                    )
                ) {

                    const buttons = [
                        ...row.querySelectorAll(
                            "button,[role='button'],a"
                        )
                    ]
                    .filter(visible);

                    const buttonData =
                        buttons.map(button => {

                            return {
                                text: clean(
                                    button.innerText ||
                                    button.textContent ||
                                    ""
                                ),
                                aria: clean(
                                    button.getAttribute(
                                        "aria-label"
                                    ) || ""
                                ),
                                title: clean(
                                    button.getAttribute(
                                        "title"
                                    ) || ""
                                )
                            };
                        });

                    return {
                        found: true,
                        rowText,
                        lower,
                        buttons: buttonData
                    };
                }

                row =
                    row.parentElement;
            }
        }

        // ----------------------------------------------------
        // Also look for explicit automatic-caption messages.
        // ----------------------------------------------------

        const body =
            norm(
                document.body.innerText || ""
            );

        const generating =
            body.includes(
                "generating automatic subtitles"
            ) ||
            body.includes(
                "generating subtitles"
            ) ||
            body.includes(
                "automatic captions are being generated"
            ) ||
            body.includes(
                "generating captions"
            ) ||
            body.includes(
                "automatic captions are still being generated"
            );

        return {
            found: false,
            generating,
            body
        };
    });
}

