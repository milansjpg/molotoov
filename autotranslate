// ============================================================
// PROCESS LANGUAGE
// ============================================================

async function processLanguage(
    page,
    language,
    completedLanguages
) {

    console.log("");
    console.log(
        "------------------------------------------------"
    );

    console.log(
        `🌎 LANGUAGE: ${language}`
    );

    console.log(
        "------------------------------------------------"
    );

    if (
        completedLanguages.has(
            language
        )
    ) {

        console.log(
            `⏭️ ${language} already completed.`
        );

        return true;
    }

    const exists =
        await languageAlreadyExists(
            page,
            language
        );

    if (exists) {

        console.log(
            `⏭️ ${language} already has subtitles — SKIPPING.`
        );

        completedLanguages.add(
            language
        );

        return true;
    }

    console.log(
        `🆕 ${language} does not have subtitles — creating.`
    );

    if (
        !await openAddLanguage(
            page
        )
    ) {
        return false;
    }

    if (
        !await selectLanguage(
            page,
            language
        )
    ) {
        return false;
    }

    if (
        !await clickManualSubtitlesAdd(
            page
        )
    ) {
        return false;
    }

    if (
        !await clickAutoTranslate(
            page
        )
    ) {

        console.log(
            `❌ Auto-translate unavailable for ${language}.`
        );

        console.log(
            "⏭️ Not publishing empty subtitle track."
        );

        return false;
    }

    if (
        !await waitForSubtitleEditor(
            page,
            language
        )
    ) {
        return false;
    }

    const published =
        await clickPublish(
            page,
            language
        );

    if (published) {

        completedLanguages.add(
            language
        );

        console.log(
            `✅ Finished ${language}.`
        );
    }

    return published;
}

