async function prepareEnglish(page, video) {

    console.log("");
    console.log(
        "================================================"
    );

    console.log(
        "🇬🇧 PREPARING ENGLISH SOURCE TRANSCRIPT"
    );

    console.log(
        "================================================"
    );

    console.log(
        `⏱️ Maximum English wait: ${ENGLISH_GENERATION_TIMEOUT} seconds`
    );

    const started =
        Date.now();

    let editClicked =
        false;

    while (
        Date.now() - started <
