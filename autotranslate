// ============================================================
// CHECK EXISTING LANGUAGE
// ============================================================

async function languageAlreadyExists(
    page,
    language
) {

    const aliases =
        LANGUAGE_ALIASES[language] ||
        [language];

    return await page.evaluate(
        aliases => {

            function normalize(text) {

                return String(text || "")
                    .replace(/\u00a0/g, " ")
                    .replace(/\s+/g, " ")
                    .trim()
                    .toLowerCase();
            }

            function visible(el) {

                if (!el)
                    return false;

                const rect =
                    el.getBoundingClientRect();

                const style =
                    getComputedStyle(el);

                return (
                    rect.width > 0 &&
                    rect.height > 0 &&
                    style.display !== "none" &&
                    style.visibility !== "hidden"
                );
            }

            const wanted =
                aliases.map(normalize);

            const labels = [
                ...document.querySelectorAll("*")
            ]
            .filter(visible);

            for (const el of labels) {

                const text =
                    normalize(
                        el.innerText ||
                        el.textContent ||
                        ""
                    );

                if (!wanted.includes(text))
                    continue;

                let row =
                    el;

                for (
                    let level = 0;
                    level < 12 && row;
                    level++
                ) {

                    const rowText =
                        normalize(
                            row.innerText ||
                            row.textContent ||
                            ""
                        );

                    if (
                        rowText.includes("published") ||
                        rowText.includes("automatic") ||
                        rowText.includes("manual") ||
                        rowText.includes("subtitle") ||
                        rowText.includes("edit")
                    ) {

                        return true;
                    }

                    row =
                        row.parentElement;
                }
            }

            return false;
        },
        aliases
    );
}

