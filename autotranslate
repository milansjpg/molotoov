                    );

                if (clicked) {

                    console.log(
                        "✅ English → Edit subtitles clicked."
                    );

                    editClicked = true;

                    await sleep(4000);

                } else {

                    // Sometimes the row is still loading.
                    console.log(
                        "⏳ English exists but Edit subtitles is not ready yet..."
                    );

                    await sleep(
                        ENGLISH_UI_DELAY
                    );

                    continue;
                }
            }

            // ------------------------------------------------
            // Once editor is open, ONLY look for English
            // Publish.
            // ------------------------------------------------

            if (editClicked) {

                const published =
                    await publishEnglish(
                        page
                    );

                if (published) {

                    console.log(
                        "✅ ENGLISH SOURCE TRANSCRIPT PUBLISHED."
                    );

                    return true;
                }

                // Don't immediately start translations.
                // Keep waiting for the English editor to finish.
                console.log(
                    "⏳ English editor opened but Publish is not ready yet."
                );

                await sleep(
                    ENGLISH_UI_DELAY
                );

                continue;
            }
        }

        // ----------------------------------------------------
        // No English row yet.
        //
        // This is where the old script was failing.
        // We DO NOT create translations here.
        // ----------------------------------------------------

        console.log(
            `⏳ Waiting for English automatic transcript... ${Math.floor((Date.now() - started) / 1000)}/${ENGLISH_GENERATION_TIMEOUT}s`
        );

        await sleep(
            ENGLISH_CHECK_DELAY
        );
    }

    console.log("");
    console.log(
        "❌ ENGLISH TRANSCRIPT NEVER BECAME AVAILABLE."
    );

    console.log(
        `⏭️ Skipping ${video.title}`
    );

    return false;
