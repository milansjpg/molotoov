        `VIDEO ${index}/${total}`
    );

    console.log(
        `TITLE: ${video.title}`
    );

    console.log(
        `ID: ${video.id}`
    );

    console.log(
        `TYPE: ${video.type}`
    );

    console.log(
        `VISIBILITY: PUBLIC`
    );

    console.log(
        "################################################"
    );

    // --------------------------------------------------------
    // Open translations
    // --------------------------------------------------------

    const opened =
        await navigateTo(
            page,
            translationsUrl(
                video.id
            ),
            video.id
        );

    if (!opened) {

        console.log(
            `⚠️ Could not navigate to video ${video.id}.`
        );

        return;
    }

    // HARD verification.
    if (
        !page.url().includes(
            `/video/${video.id}/`
        )
    ) {

        console.log(
            "❌ VIDEO ID VERIFICATION FAILED."
        );

        return;
    }

    console.log(
        "✅ Correct video loaded."
    );

    await sleep(
        VIDEO_LOAD_DELAY
    );

    // ========================================================
    // ABSOLUTELY FIRST: ENGLISH
    // ========================================================

    const englishReady =
        await prepareEnglish(
            page,
            video
        );

    if (!englishReady) {

        console.log("");
        console.log(
            "🚫 ENGLISH WAS NOT GENERATED."
        );

        console.log(
            "🚫 NO TRANSLATIONS WILL BE CREATED."
        );

        console.log(
            `⏭️ Skipping video ${index}/${total}.`
        );

        return;
    }

    // ========================================================
    // RETURN TO TRANSLATIONS AFTER ENGLISH EDITOR
    // ========================================================

    console.log(
        "↩️ Returning to translations page..."
    );

    const backToTranslations =
        await navigateTo(
            page,
            translationsUrl(
                video.id
            ),
            video.id
        );

    if (!backToTranslations) {

        console.log(
            "❌ Could not return to translations."
        );

        return;
    }

    // ========================================================
    // DOUBLE SAFETY CHECK
    //
    // We inspect English one more time before allowing
    // translations.
    // ========================================================

    const englishFinal =
        await inspectEnglishRow(
            page
        );

    if (!englishFinal.found) {

        console.log(
            "🚫 FINAL ENGLISH CHECK FAILED."
        );

        console.log(
            "🚫 REFUSING TO CREATE TRANSLATIONS."
        );

        return;
    }

    console.log(
        "✅ FINAL ENGLISH SOURCE CHECK PASSED."
    );

    // ========================================================
    // TRANSLATIONS
    // ========================================================

    const completedLanguages =
        new Set();

    console.log("");
    console.log(
        "================================================"
    );

    console.log(
        "STARTING LANGUAGE CHECKS"
    );

    console.log(
        "================================================"
    );

    for (
        let i = 0;
        i < LANGUAGES.length;
        i++
    ) {

        const language =
            LANGUAGES[i];

        console.log("");
        console.log(
            `LANGUAGE ${i + 1}/${LANGUAGES.length}`
        );

        try {

            await processLanguage(
                page,
                language,
                completedLanguages
            );

        } catch (err) {

            console.log("");
            console.log(
                `❌ ${language} ERROR`
            );

            console.log(
                err.message
            );
        }

        await sleep(2500);

        // ----------------------------------------------------
        // Make sure we're still on this video.
        // ----------------------------------------------------

        if (
            !page.url().includes(
                `/video/${video.id}/`
            )
        ) {

            console.log(
                "⚠️ Wrong video detected."
            );

            console.log(
                `Expected: ${video.id}`
            );

            console.log(
                `Current: ${page.url()}`
            );

            console.log(
                "↩️ Recovering..."
            );

            const recovered =
                await navigateTo(
                    page,
                    translationsUrl(
                        video.id
                    ),
                    video.id
                );

            if (!recovered) {

                console.log(
                    "❌ Could not recover video."
                );

                break;
            }
        }

        // ----------------------------------------------------
        // Return to translations.
        // ----------------------------------------------------

        if (
            !page.url().includes(
                "/translations"
            )
        ) {

            console.log(
                "↩️ Returning to translations..."
            );

            const recovered =
                await navigateTo(
                    page,
                    translationsUrl(
                        video.id
                    ),
                    video.id
                );

            if (!recovered) {

                console.log(
                    "❌ Could not return to translations."
                );

                break;
            }

            await sleep(2500);
        }
    }

    console.log("");
    console.log(
        "================================================"
    );

    console.log(
        `✅ FINISHED VIDEO ${index}/${total}`
    );

    console.log(
        `Languages completed/skipped: ${completedLanguages.size}/${LANGUAGES.length}`
    );

    console.log(
        "================================================"
    );
}

